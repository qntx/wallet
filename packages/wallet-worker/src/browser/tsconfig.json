{
  // DOM code — checked without Node types. The nested tsconfig.json also makes the
  // type-aware lint project service assign these files here (nearest including tsconfig).
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": []
  },
  // The passkey unit test exercises DOM-only source, so the lint project service and
  // the typecheck script must see it through this DOM program, not the package one.
  "include": [".", "../../tests/browser-passkey.test.ts"]
}
