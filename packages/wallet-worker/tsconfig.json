{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "tests", "scripts", "vite.config.ts"],
  // DOM and WebWorker code live in nested per-directory tsconfig.json programs
  // (src/browser, src/worker's browser files, tests/browser/page, tests/web); each is also the
  // project the type-aware lint service assigns those files to.
  "exclude": [
    "src/browser",
    "src/worker/worker.ts",
    "src/worker/browser-kernel.ts",
    "src/worker/indexeddb.ts",
    "src/worker/anchor.ts",
    "tests/browser/page",
    "tests/web",
    "tests/browser-passkey.test.ts"
  ]
}
