{
  "name": "@qntx/wallet-worker",
  "version": "0.4.0",
  "description": "Web Worker and worker_threads hosts for @qntx/wallet",
  "keywords": [
    "nostr",
    "sdk",
    "self-custodial",
    "typescript",
    "wallet",
    "worker"
  ],
  "homepage": "https://github.com/qntx/wallet#readme",
  "bugs": {
    "url": "https://github.com/qntx/wallet/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/wallet.git",
    "directory": "packages/wallet-worker"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs",
      "default": "./dist/browser.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs",
      "default": "./dist/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run @qntx/wallet#build && vp pack && bun build --target node --splitting --outdir dist --entry-naming \"kernel.[name].js\" src/worker/node.ts && bun build --target browser --splitting --outdir dist --entry-naming \"kernel.[name].js\" src/worker/worker.ts && bun scripts/copy-spark-wasm.ts && bun scripts/kernel-manifest.ts",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "smoke:hermes": "vp run @qntx/wallet#build && bun scripts/hermes-smoke.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p src/browser/tsconfig.json && tsc --noEmit -p src/worker/tsconfig.json && tsc --noEmit -p tests/browser/page/tsconfig.json",
    "check:pkg": "bun run build && publint && attw --pack . --profile esm-only",
    "pack:local": "bun run build && bun pm pack",
    "test:consumer": "bun scripts/consumer-smoke.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@noble/hashes": "2.4.0",
    "@playwright/test": "1.64.1",
    "@qntx/nostr": "0.15.3",
    "@qntx/spark": "0.5.2",
    "@qntx/spark-wasm": "0.5.2",
    "@qntx/tsconfig": "1.0.1",
    "@qntx/wallet": "0.4.0",
    "@qntx/wallet-kernel": "0.4.0",
    "@scure/base": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "@types/node": "26.6.5",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "@qntx/wallet": "0.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
