+/* Emulator config store. The non-THD89 (int-tag) storage scheme uses the key
+   as a logical tag, but config.set/get() present it as a byte offset into the
+   SE regions, so every entry would collide in the flat arrays above. Keep a
+   sparse (private,key) -> value map instead, persisted like the regions. */
+#define SE_KV_MAX 512
+
+typedef struct {
+  uint32_t key;
+  uint8_t priv;
+  uint16_t len;
+  uint8_t val[256];
+} se_kv_entry;
+
+static se_kv_entry se_kv[SE_KV_MAX];
+static int se_kv_count;
+static bool se_kv_loaded;
+
+static void se_kv_path(char *buf, size_t buf_len) {
+  snprintf(buf, buf_len, "%s/se_kv.bin", profile_dir());
+}
+
+static void se_kv_save(void) {
+  char path[1024];
+  se_kv_path(path, sizeof(path));
+  FILE *f = fopen(path, "wb");
+  if (f == NULL) return;
+  for (int i = 0; i < se_kv_count; i++) {
+    fwrite(&se_kv[i].key, sizeof(se_kv[i].key), 1, f);
+    fwrite(&se_kv[i].priv, sizeof(se_kv[i].priv), 1, f);
+    fwrite(&se_kv[i].len, sizeof(se_kv[i].len), 1, f);
+    fwrite(se_kv[i].val, se_kv[i].len, 1, f);
+  }
+  fclose(f);
+}
+
+static void se_kv_ensure_loaded(void) {
+  if (se_kv_loaded) return;
+  se_kv_loaded = true;
+  char path[1024];
+  se_kv_path(path, sizeof(path));
+  FILE *f = fopen(path, "rb");
+  if (f == NULL) return;
+  while (se_kv_count < SE_KV_MAX) {
+    se_kv_entry *e = &se_kv[se_kv_count];
+    if (fread(&e->key, sizeof(e->key), 1, f) != 1) break;
+    if (fread(&e->priv, sizeof(e->priv), 1, f) != 1) break;
+    if (fread(&e->len, sizeof(e->len), 1, f) != 1) break;
+    if (e->len > sizeof(e->val)) break;
+    if (fread(e->val, e->len, 1, f) != 1 && e->len > 0) break;
+    se_kv_count++;
+  }
+  fclose(f);
+}
+
+static int se_kv_find(int priv, uint32_t key) {
+  for (int i = 0; i < se_kv_count; i++) {
+    if (se_kv[i].priv == priv && se_kv[i].key == key) return i;
+  }
+  return -1;
+}
+
+int se_emu_kv_len(int priv, uint32_t key) {
+  se_kv_ensure_loaded();
+  int i = se_kv_find(priv, key);
+  return i < 0 ? -1 : se_kv[i].len;
+}
+
+secbool se_emu_kv_get(int priv, uint32_t key, uint8_t *out, uint16_t len) {
+  se_kv_ensure_loaded();
+  int i = se_kv_find(priv, key);
+  if (i < 0 || len < se_kv[i].len) return secfalse;
+  memcpy(out, se_kv[i].val, se_kv[i].len);
+  return sectrue;
+}
+
+secbool se_emu_kv_set(int priv, uint32_t key, const uint8_t *val,
+                      uint16_t len) {
+  if (len > sizeof(((se_kv_entry *)0)->val)) return secfalse;
+  se_kv_ensure_loaded();
+  int i = se_kv_find(priv, key);
+  if (i < 0) {
+    if (se_kv_count >= SE_KV_MAX) return secfalse;
+    i = se_kv_count++;
+    se_kv[i].priv = priv;
+    se_kv[i].key = key;
+  }
+  se_kv[i].len = len;
+  memcpy(se_kv[i].val, val, len);
+  se_kv_save();
+  return sectrue;
+}
+
+secbool se_emu_kv_delete(int priv, uint32_t key) {
+  se_kv_ensure_loaded();
+  int i = se_kv_find(priv, key);
+  if (i < 0) return sectrue;
+  se_kv[i] = se_kv[--se_kv_count];
+  se_kv_save();
+  return sectrue;
+}
