new file mode 100644
index 0000000..ac9140d
--- /dev/null
+++ b/core/embed/unix/se_stubs.c
@@ -0,0 +1,419 @@
+/*
+ * Emulator stand-ins for the THD89 secure element and fingerprint sensor.
+ * The SE is the backing store for the python config layer
+ * (se_get/set_public/private_region), so the regions persist to files in
+ * the profile directory like the norcow flash file does. Everything else
+ * reports the hardware as absent: no PIN, no wipe code, no fingerprint.
+ */
+#include <stdio.h>
+#include <string.h>
+
+#include <stdlib.h>
+
+#include "memzero.h"
+#include "profile.h"
+#include "se_stubs.h"
+#include "hardware_version.h"
+
+static uint8_t public_region[PUBLIC_REGION_SIZE];
+static uint8_t private_region[PRIVATE_REGION_SIZE];
+static uint32_t u2f_counter;
+static bool regions_loaded;
+
+static void region_path(char *buf, size_t buf_len, const char *name) {
+  snprintf(buf, buf_len, "%s/se_%s.bin", profile_dir(), name);
+}
+
+static void region_load(uint8_t *region, uint16_t size, const char *name) {
+  char path[1024];
+  region_path(path, sizeof(path), name);
+  FILE *f = fopen(path, "rb");
+  if (f != NULL) {
+    if (fread(region, 1, size, f) != size) {
+      memzero(region, size);
+    }
+    fclose(f);
+  }
+}
+
+static void regions_ensure_loaded(void) {
+  if (!regions_loaded) {
+    regions_loaded = true;
+    region_load(public_region, sizeof(public_region), "public");
+    region_load(private_region, sizeof(private_region), "private");
+  }
+}
+
+static void region_store(const uint8_t *region, uint16_t size,
+                         const char *name) {
+  char path[1024];
+  region_path(path, sizeof(path), name);
+  FILE *f = fopen(path, "wb");
+  if (f != NULL) {
+    fwrite(region, 1, size, f);
+    fclose(f);
+  }
+}
+
+static secbool region_get(uint8_t *region, uint16_t size, uint16_t offset,
+                          void *val_dest, uint16_t len) {
+  regions_ensure_loaded();
+  if ((uint32_t)offset + len > size) {
+    return secfalse;
+  }
+  memcpy(val_dest, region + offset, len);
+  return sectrue;
+}
+
+static secbool region_set(uint8_t *region, uint16_t size, const char *name,
+                          uint16_t offset, const void *val_src, uint16_t len) {
+  regions_ensure_loaded();
+  if ((uint32_t)offset + len > size) {
+    return secfalse;
+  }
+  memcpy(region + offset, val_src, len);
+  region_store(region, size, name);
+  return sectrue;
+}
+
+secbool se_get_public_region(uint16_t offset, void *val_dest, uint16_t len) {
+  return region_get(public_region, sizeof(public_region), offset, val_dest,
+                    len);
+}
+
+secbool se_set_public_region(uint16_t offset, const void *val_src,
+                             uint16_t len) {
+  return region_set(public_region, sizeof(public_region), "public", offset,
+                    val_src, len);
+}
+
+secbool se_get_private_region(uint16_t offset, void *val_dest, uint16_t len) {
+  return region_get(private_region, sizeof(private_region), offset, val_dest,
+                    len);
+}
+
+secbool se_set_private_region(uint16_t offset, const void *val_src,
+                              uint16_t len) {
+  return region_set(private_region, sizeof(private_region), "private", offset,
+                    val_src, len);
+}
+
+secbool se_reset_storage(void) {
+  memzero(public_region, sizeof(public_region));
+  memzero(private_region, sizeof(private_region));
+  regions_loaded = true;
+  region_store(public_region, sizeof(public_region), "public");
+  region_store(private_region, sizeof(private_region), "private");
+  return sectrue;
+}
+
+secbool se_set_u2f_counter(uint32_t counter) {
+  u2f_counter = counter;
+  return sectrue;
+}
+
+secbool se_get_u2f_counter(uint32_t *counter) {
+  *counter = u2f_counter;
+  return sectrue;
+}
+
+secbool se_get_fido2_resident_credentials(uint32_t index, uint8_t *dest,
+                                          uint16_t *dst_len) {
+  (void)index;
+  (void)dest;
+  (void)dst_len;
+  return secfalse;
+}
