{
  "name": "@qntx/wallet-native",
  "version": "0.8.1",
  "description": "Native kernel runtime host for the qntx wallet — CBOR transport, KernelHost adapter and createNativeWallet",
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/wallet.git",
    "directory": "packages/wallet-native"
  },
  "files": [
    "dist",
    "cpp",
    "android",
    "kernel/generated",
    "nitrogen",
    "scripts",
    "react-native.config.js",
    "WalletNative.podspec",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run @qntx/wallet#build && vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "codegen": "nitrogen",
    "check:pkg": "vp pack && bun ../../scripts/check-dist-deps.ts . && publint && attw --pack . --profile esm-only && bun ../../scripts/check-native-pack.ts ."
  },
  "dependencies": {
    "cborg": "6.1.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@qntx/nostr": "0.15.3",
    "@qntx/nostr-native": "0.15.3",
    "@qntx/spark": "0.5.2",
    "@qntx/spark-native": "0.5.2",
    "@qntx/tsconfig": "1.0.1",
    "@scure/base": "2.4.0",
    "nitrogen": "0.37.1",
    "publint": "0.3.25",
    "react-native-nitro-modules": "0.37.1"
  },
  "peerDependencies": {
    "@qntx/nostr-native": "0.15.3",
    "@qntx/spark-native": "0.5.2",
    "@qntx/wallet": "0.8.1",
    "react-native": "~0.88.0",
    "react-native-nitro-modules": "~0.37.1"
  }
}
