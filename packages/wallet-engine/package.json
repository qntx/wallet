{
  "name": "@qntx/wallet-engine",
  "version": "0.9.0",
  "description": "qntx/wallet engine primitives: controllers, events and encrypted engine storage",
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/wallet.git",
    "directory": "packages/wallet-engine"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./gateway/contract": {
      "types": "./dist/gateway-contract.d.mts",
      "import": "./dist/gateway-contract.mjs",
      "default": "./dist/gateway-contract.mjs"
    },
    "./idb": {
      "types": "./dist/idb.d.mts",
      "import": "./dist/idb.mjs",
      "default": "./dist/idb.mjs"
    },
    "./connect": {
      "types": "./dist/connect.d.mts",
      "import": "./dist/connect.mjs",
      "default": "./dist/connect.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run @qntx/wallet-worker#build && vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p src/idb/tsconfig.json && tsc --noEmit -p src/connect/inject/tsconfig.json",
    "check:pkg": "vp pack && bun ../../scripts/check-dist-deps.ts . && publint && attw --pack . --profile esm-only",
    "connect:provider": "bun ../../scripts/build-provider.ts",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@qntx/siwx": "0.8.0",
    "@scure/base": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "@solana-program/compute-budget": "0.20.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.5.0",
    "viem": "2.57.12",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.64.1",
    "@qntx/nostr": "0.15.3",
    "@qntx/spark": "0.5.2",
    "@qntx/spark-wasm": "0.5.2",
    "@qntx/wallet": "0.9.0",
    "@qntx/wallet-chains": "0.9.0",
    "@qntx/wallet-worker": "0.9.0",
    "@solana-program/token-2022": "0.20.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@solana/wallet-standard-util": "1.2.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "@wallet-standard/wallet": "1.1.1",
    "fake-indexeddb": "6.2.6",
    "publint": "0.3.25"
  },
  "peerDependencies": {
    "@qntx/nostr": "~0.15.3",
    "@qntx/spark": "~0.5.2",
    "@qntx/wallet": "0.9.0",
    "@qntx/wallet-chains": "0.9.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
