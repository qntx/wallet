{
  "name": "@qntx/wallet-engine",
  "version": "0.14.1",
  "description": "qntx/wallet engine primitives: controllers, events and encrypted engine storage",
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/wallet.git",
    "directory": "packages/wallet-engine"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./gateway/contract": {
      "types": "./dist/gateway-contract.d.mts",
      "import": "./dist/gateway-contract.mjs",
      "default": "./dist/gateway-contract.mjs"
    },
    "./idb": {
      "types": "./dist/idb.d.mts",
      "import": "./dist/idb.mjs",
      "default": "./dist/idb.mjs"
    },
    "./connect": {
      "types": "./dist/connect.d.mts",
      "import": "./dist/connect.mjs",
      "default": "./dist/connect.mjs"
    },
    "./apps": {
      "types": "./dist/apps.d.mts",
      "import": "./dist/apps.mjs",
      "default": "./dist/apps.mjs"
    },
    "./walletconnect": {
      "types": "./dist/walletconnect.d.mts",
      "import": "./dist/walletconnect.mjs",
      "default": "./dist/walletconnect.mjs"
    },
    "./apps/fiat24": {
      "types": "./dist/apps-fiat24.d.mts",
      "import": "./dist/apps-fiat24.mjs",
      "default": "./dist/apps-fiat24.mjs"
    },
    "./apps/hyperliquid": {
      "types": "./dist/apps-hyperliquid.d.mts",
      "import": "./dist/apps-hyperliquid.mjs",
      "default": "./dist/apps-hyperliquid.mjs"
    },
    "./apps/polymarket": {
      "types": "./dist/apps-polymarket.d.mts",
      "import": "./dist/apps-polymarket.mjs",
      "default": "./dist/apps-polymarket.mjs"
    },
    "./push": {
      "types": "./dist/push.d.mts",
      "import": "./dist/push.mjs",
      "default": "./dist/push.mjs"
    },
    "./qr": {
      "types": "./dist/qr.d.mts",
      "import": "./dist/qr.mjs",
      "default": "./dist/qr.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run @qntx/wallet-worker#build && vp pack",
    "test": "vp test --project unit && bun scripts/size-check.ts",
    "test:coverage": "vp test --coverage --project unit",
    "fuzz": "vp test fuzz --testTimeout 1800000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p src/idb/tsconfig.json && tsc --noEmit -p src/connect/inject/tsconfig.json",
    "check:pkg": "vp pack && bun ../../scripts/check-dist-deps.ts . && bun ../../scripts/check-api.ts . && publint && attw --pack . --profile esm-only",
    "connect:provider": "bun ../../scripts/build-provider.ts",
    "test:speculos": "vp test --project speculos",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "smoke:hermes": "bun scripts/hermes-smoke.ts"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "0.33.3",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@qntx/fiat24": "0.1.0",
    "@qntx/siwx": "0.8.0",
    "@qntx/ur": "4.1.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "@solana-program/address-lookup-table": "0.16.0",
    "@solana-program/compute-budget": "0.20.0",
    "@solana-program/stake": "0.11.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana-program/token-2022": "0.20.0",
    "@solana/kit": "8.5.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "ox": "1.8.12",
    "viem": "2.57.12",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@blockchaincommons/dcbor": "1.0.0-beta.5",
    "@keystonehq/bc-ur-registry": "0.8.1",
    "@keystonehq/bc-ur-registry-eth": "0.23.0",
    "@keystonehq/bc-ur-registry-sol": "0.9.5",
    "@keystonehq/bc-ur-registry-tron": "0.5.0",
    "@noble/curves": "2.0.1",
    "@playwright/test": "1.64.1",
    "@qntx/nostr": "0.16.0",
    "@qntx/spark": "0.5.2",
    "@qntx/spark-wasm": "0.5.2",
    "@qntx/ur": "4.1.0",
    "@qntx/wallet": "0.14.1",
    "@qntx/wallet-chains": "0.14.1",
    "@qntx/wallet-worker": "0.14.1",
    "@reown/walletkit": "1.6.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@solana/wallet-standard-util": "1.2.0",
    "@tronweb3/tronwallet-adapter-tronlink": "1.3.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "@wallet-standard/wallet": "1.1.1",
    "@walletconnect/core": "2.25.0",
    "@walletconnect/sign-client": "2.25.0",
    "@walletconnect/types": "2.25.0",
    "@walletconnect/utils": "2.25.0",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "micro-key-producer": "0.10.2",
    "publint": "0.3.25",
    "tronweb": "6.5.2"
  },
  "peerDependencies": {
    "@qntx/nostr": "~0.16.0",
    "@qntx/spark": "~0.5.2",
    "@qntx/wallet": "0.14.1",
    "@qntx/wallet-chains": "0.14.1",
    "@reown/walletkit": "1.6.0",
    "@walletconnect/core": "2.25.0",
    "@walletconnect/types": "2.25.0",
    "@walletconnect/utils": "2.25.0"
  },
  "peerDependenciesMeta": {
    "@reown/walletkit": {
      "optional": true
    },
    "@walletconnect/core": {
      "optional": true
    },
    "@walletconnect/types": {
      "optional": true
    },
    "@walletconnect/utils": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
