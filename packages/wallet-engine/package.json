{
  "name": "@qntx/wallet-engine",
  "version": "0.4.0",
  "description": "qntx/wallet engine primitives: controllers, events and encrypted engine storage",
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/wallet.git",
    "directory": "packages/wallet-engine"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./idb": {
      "types": "./dist/idb.d.mts",
      "import": "./dist/idb.mjs",
      "default": "./dist/idb.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run @qntx/wallet-worker#build && vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p src/idb/tsconfig.json",
    "check:pkg": "vp pack && publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@scure/base": "^2.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@noble/hashes": "^2.0.1",
    "@qntx/nostr": "0.15.1",
    "@qntx/spark": "0.5.1",
    "@qntx/spark-wasm": "0.5.1",
    "@qntx/wallet": "0.4.0",
    "@qntx/wallet-worker": "0.4.0",
    "fake-indexeddb": "6.2.6",
    "publint": "0.3.25"
  },
  "peerDependencies": {
    "@qntx/nostr": "^0.15.0",
    "@qntx/spark": "^0.5.0",
    "@qntx/wallet": "0.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
