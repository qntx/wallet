{
  "name": "@qntx/wallet-chains",
  "version": "0.4.0",
  "description": "qntx/wallet chain semantics: SignRequest codecs, display decoding, verifiability and signing for EVM, Solana and Bitcoin",
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/wallet.git",
    "directory": "packages/wallet-chains"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./evm": {
      "types": "./dist/evm.d.mts",
      "default": "./dist/evm.mjs"
    },
    "./evm/sign": {
      "types": "./dist/evm-sign.d.mts",
      "default": "./dist/evm-sign.mjs"
    },
    "./solana": {
      "types": "./dist/solana.d.mts",
      "default": "./dist/solana.mjs"
    },
    "./solana/sign": {
      "types": "./dist/solana-sign.d.mts",
      "default": "./dist/solana-sign.mjs"
    },
    "./bitcoin": {
      "types": "./dist/bitcoin.d.mts",
      "default": "./dist/bitcoin.mjs"
    },
    "./bitcoin/sign": {
      "types": "./dist/bitcoin-sign.d.mts",
      "default": "./dist/bitcoin-sign.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test && bun scripts/size-check.ts",
    "typecheck": "tsc --noEmit",
    "smoke:hermes": "bun scripts/hermes-smoke.ts",
    "check:pkg": "vp pack && bun ../../scripts/check-dist-deps.ts . && publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "@solana/addresses": "8.5.0",
    "@solana/codecs": "8.5.0",
    "@solana/transaction-messages": "8.5.0",
    "@solana/transactions": "8.5.0",
    "ox": "1.8.9"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@metamask/eth-sig-util": "9.0.0",
    "@qntx/tsconfig": "1.0.1",
    "@scure/bip39": "2.4.0",
    "@solana-program/compute-budget": "0.20.0",
    "@solana-program/stake": "0.11.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana-program/token-2022": "0.20.0",
    "@solana/kit": "8.5.0",
    "@types/node": "26.6.5",
    "bitcoinjs-lib": "^7.0.5",
    "ecpair": "^3.0.2",
    "publint": "0.3.25",
    "tiny-secp256k1": "^2.2.5",
    "typescript": "7.0.2",
    "viem": "2.57.8",
    "vite-plus": "1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
