{
  "name": "@qntx/wallet-chains",
  "version": "0.4.0",
  "private": true,
  "description": "qntx/wallet chain semantics: SignRequest codecs, display decoding and verifiability (private, bundled by the host packages)",
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/wallet.git",
    "directory": "packages/wallet-chains"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./evm": "./src/evm/index.ts",
    "./evm/sign": "./src/evm/sign.ts",
    "./solana": "./src/solana/index.ts",
    "./solana/sign": "./src/solana/sign.ts",
    "./bitcoin": "./src/bitcoin/index.ts",
    "./bitcoin/sign": "./src/bitcoin/sign.ts"
  },
  "scripts": {
    "test": "vp test && bun scripts/size-check.ts",
    "typecheck": "tsc --noEmit",
    "smoke:hermes": "bun scripts/hermes-smoke.ts"
  },
  "dependencies": {
    "@scure/btc-signer": "2.4.1",
    "@solana/addresses": "8.5.0",
    "@solana/codecs": "8.5.0",
    "@solana/transaction-messages": "8.5.0",
    "@solana/transactions": "8.5.0",
    "ox": "1.8.9"
  },
  "devDependencies": {
    "@metamask/eth-sig-util": "9.0.0",
    "@qntx/tsconfig": "1.0.1",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@solana-program/compute-budget": "0.20.0",
    "@solana-program/stake": "0.11.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana-program/token-2022": "0.20.0",
    "@solana/kit": "8.5.0",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "viem": "2.57.8",
    "vite-plus": "1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
