{
  "name": "n3-budget-b",
  "main": "entry.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    "SCALE": "production",
    "UPSTREAM_DELAY_MS": "0"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROVIDER_BUDGET",
        "class_name": "ProviderBudgetObject",
        "script_name": "n3-budget-a"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "RPC_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 10 }
    },
    {
      "name": "DEFAULT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 50, "period": 10 }
    },
    {
      "name": "IP_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 300, "period": 10 }
    },
    {
      "name": "SHARE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 1000, "period": 60 }
    }
  ]
}
