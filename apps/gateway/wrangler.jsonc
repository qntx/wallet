{
  "account_id": "9241dfd75bea0009a3870173f7e1acd2",
  // The top level is never deployed — a bare `wrangler deploy` lands on this local-only name.
  "name": "wallet-gateway-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // Invocation logs record request URLs (quote queries carry wallet addresses) and client
  // metadata — our own JSON request-log lines stay instead.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "env": {
    "staging": {
      "name": "wallet-gateway-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "wallet-gateway-staging.qntx.org", "custom_domain": true }],
      "vars": {
        "CORS_ORIGINS": "http://localhost:5173,http://localhost:8081",
        "NETWORKS": "staging",
      },
      "triggers": { "crons": ["0 * * * *"] },
      "secrets": { "required": ["ZEROX_API_KEY"] },
      "kv_namespaces": [
        {
          "binding": "RISK",
          "id": "8193c99055c942898a62239dc0252837",
          "preview_id": "41f33427d52a480784d01947ef604d7a",
        },
      ],
      "ratelimits": [
        {
          "name": "RPC_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 100, "period": 10 },
        },
        {
          "name": "DEFAULT_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 50, "period": 10 },
        },
        {
          "name": "IP_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 300, "period": 10 },
        },
      ],
    },
    "production": {
      "name": "wallet-gateway",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "gateway.meowl.xyz", "custom_domain": true }],
      "vars": { "CORS_ORIGINS": "", "NETWORKS": "production" },
      "triggers": { "crons": ["0 * * * *"] },
      "secrets": {
        "required": [
          "ZEROX_API_KEY",
          "JUPITER_API_KEY",
          "ALCHEMY_API_KEY",
          "DRPC_API_KEY",
          "BLOCKSTREAM_CLIENT_ID",
          "BLOCKSTREAM_CLIENT_SECRET",
        ],
      },
      "kv_namespaces": [{ "binding": "RISK", "id": "983019ff51a54c5abea1a0a8189d299d" }],
      "ratelimits": [
        {
          "name": "RPC_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 100, "period": 10 },
        },
        {
          "name": "DEFAULT_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 50, "period": 10 },
        },
        {
          "name": "IP_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 300, "period": 10 },
        },
      ],
    },
  },
}
