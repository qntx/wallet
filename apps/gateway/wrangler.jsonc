{
  "name": "wallet-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "env": {
    "staging": {
      "name": "wallet-gateway-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "wallet-gateway-staging.qntx.org", "custom_domain": true }],
      "vars": { "CORS_ORIGINS": "http://localhost:5173,http://localhost:8081" },
      "triggers": { "crons": ["17 * * * *"] },
      "kv_namespaces": [{ "binding": "RISK", "id": "8193c99055c942898a62239dc0252837" }],
      "ratelimits": [
        {
          "name": "RPC_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 100, "period": 10 },
        },
        {
          "name": "DEFAULT_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 50, "period": 10 },
        },
      ],
    },
  },
}
