{
  // The top level is never deployed — a bare `wrangler deploy` lands on this local-only name.
  "name": "wallet-gateway-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // Invocation logs record request URLs (quote queries carry wallet addresses) and client
  // metadata — our own JSON request-log lines stay instead.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // One object per provider account name (PROVIDER_BUDGET) and one per push family (PUSH); the
  // bindings live per env, the migrations are shared.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProviderBudgetObject"] },
    { "tag": "v2", "new_sqlite_classes": ["PushObject"] },
  ],
  "env": {
    "staging": {
      // Must differ from production's account: Workers Scripts Edit is account-wide, so a staging
      // token in the production account could replace the production Worker. The deploy workflow
      // refuses to deploy staging until it has its own account (README "Deployment pipeline").
      "account_id": "9241dfd75bea0009a3870173f7e1acd2",
      "name": "wallet-gateway-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "wallet-gateway-staging.qntx.org", "custom_domain": true }],
      "vars": {
        "CORS_ORIGINS": "http://localhost:5173,http://localhost:8081",
        "NETWORKS": "staging",
      },
      "triggers": { "crons": ["0 * * * *"] },
      "secrets": { "required": ["ZEROX_API_KEY"] },
      "kv_namespaces": [
        {
          "binding": "RISK",
          "id": "8193c99055c942898a62239dc0252837",
          "preview_id": "41f33427d52a480784d01947ef604d7a",
        },
      ],
      // Rate-limit bindings count per Cloudflare location; PROVIDER_BUDGET is the one
      // worldwide counter an upstream credential's quota needs (README "Rate limiting").
      "durable_objects": {
        "bindings": [
          { "name": "PROVIDER_BUDGET", "class_name": "ProviderBudgetObject" },
          { "name": "PUSH", "class_name": "PushObject" },
        ],
      },
      // IP/RPC/DEFAULT count requests (an RPC batch's calls count individually). SHARE_LIMITER's
      // units are shares of a provider account's per-minute budget, keyed account:ip-prefix.
      // PUSH_LIMITER charges subscription writes per IP prefix (PUT costs 5).
      "ratelimits": [
        {
          "name": "RPC_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 1500, "period": 60 },
        },
        {
          "name": "DEFAULT_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 400, "period": 60 },
        },
        {
          "name": "IP_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 3000, "period": 60 },
        },
        {
          "name": "SHARE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 1000, "period": 60 },
        },
        {
          "name": "PUSH_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
    },
    "production": {
      "account_id": "9241dfd75bea0009a3870173f7e1acd2",
      "name": "wallet-gateway",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "gateway.meowl.xyz", "custom_domain": true }],
      "vars": { "CORS_ORIGINS": "", "NETWORKS": "production" },
      "triggers": { "crons": ["0 * * * *"] },
      "secrets": {
        "required": [
          "ZEROX_API_KEY",
          "JUPITER_API_KEY",
          "ALCHEMY_API_KEY",
          "DRPC_API_KEY",
          "ANKR_API_KEY",
          "BLOCKSTREAM_CLIENT_ID",
          "BLOCKSTREAM_CLIENT_SECRET",
          "COINGECKO_API_KEY",
          "TRONGRID_API_KEY",
          "TATUM_API_KEY",
        ],
      },
      "kv_namespaces": [{ "binding": "RISK", "id": "983019ff51a54c5abea1a0a8189d299d" }],
      "durable_objects": {
        "bindings": [
          { "name": "PROVIDER_BUDGET", "class_name": "ProviderBudgetObject" },
          { "name": "PUSH", "class_name": "PushObject" },
        ],
      },
      // IP/RPC/DEFAULT count requests (an RPC batch's calls count individually). SHARE_LIMITER's
      // units are shares of a provider account's per-minute budget, keyed account:ip-prefix.
      // PUSH_LIMITER charges subscription writes per IP prefix (PUT costs 5).
      "ratelimits": [
        {
          "name": "RPC_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 1500, "period": 60 },
        },
        {
          "name": "DEFAULT_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 400, "period": 60 },
        },
        {
          "name": "IP_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 3000, "period": 60 },
        },
        {
          "name": "SHARE_LIMITER",
          "namespace_id": "2004",
          "simple": { "limit": 1000, "period": 60 },
        },
        {
          "name": "PUSH_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
    },
  },
}
