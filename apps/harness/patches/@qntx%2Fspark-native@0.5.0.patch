diff --git a/android/CMakeLists.txt b/android/CMakeLists.txt
index f2c91a3a7e65c82acc17c483d67c90130735306b..b7aa8ee8ba15367bba07e77b34e96df0a607e150 100644
--- a/android/CMakeLists.txt
+++ b/android/CMakeLists.txt
@@ -17,11 +17,11 @@ add_library(${PACKAGE_NAME} SHARED ${shared_files})
 # Add Nitrogen specs :)
 include(${CMAKE_SOURCE_DIR}/../nitrogen/generated/android/SparkNative+autolinking.cmake)
 
-add_library(qntx_spark SHARED IMPORTED)
-set_target_properties(
-        qntx_spark
-        PROPERTIES IMPORTED_LOCATION
-        ${CMAKE_SOURCE_DIR}/src/main/jniLibs/${ANDROID_ABI}/libqntx_spark.so
+# libqntx_spark.so carries no SONAME — linking it by file path would record
+# that path in DT_NEEDED and the loader could not find it at runtime. Link it
+# by name instead (PUBLIC: this module's link libraries are transitive).
+target_link_directories(${PACKAGE_NAME} PUBLIC
+        ${CMAKE_SOURCE_DIR}/src/main/jniLibs/${ANDROID_ABI}
 )
 
 include_directories(
