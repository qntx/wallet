{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge", "squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "ci / ci", "integration_id": 15368 },
          { "context": "smoke / ci", "integration_id": 15368 },
          { "context": "audit", "integration_id": 15368 },
          { "context": "evm-anvil", "integration_id": 15368 },
          { "context": "solana-e2e", "integration_id": 15368 },
          { "context": "bitcoin-e2e", "integration_id": 15368 },
          { "context": "playwright", "integration_id": 15368 },
          { "context": "native-host-test", "integration_id": 15368 }
        ]
      }
    }
  ]
}
