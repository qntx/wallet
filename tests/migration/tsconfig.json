{
  // Compiles the MIGRATION.md snippets against the package sources, the way a host imports them.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom"],
    "declaration": false,
    "isolatedDeclarations": false,
    "paths": {
      "@qntx/wallet": ["../../packages/wallet/src/index.ts"],
      "@qntx/wallet/*": ["../../packages/wallet/src/*/index.ts"],
      "@qntx/wallet-chains": ["../../packages/wallet-chains/src/index.ts"],
      "@qntx/wallet-chains/*": ["../../packages/wallet-chains/src/*/index.ts"],
      "@qntx/wallet-engine": ["../../packages/wallet-engine/src/index.ts"],
      "@qntx/wallet-engine/connect": ["../../packages/wallet-engine/src/connect/index.ts"],
      "@qntx/wallet-engine/walletconnect": [
        "../../packages/wallet-engine/src/walletconnect/index.ts"
      ],
      "@qntx/wallet-engine/apps": ["../../packages/wallet-engine/src/apps/index.ts"],
      "@qntx/wallet-engine/apps/hyperliquid": [
        "../../packages/wallet-engine/src/apps/hyperliquid/index.ts"
      ],
      "@qntx/wallet-engine/apps/polymarket": [
        "../../packages/wallet-engine/src/apps/polymarket/index.ts"
      ],
      "@qntx/wallet-engine/gateway/contract": [
        "../../packages/wallet-engine/src/gateway/contract/index.ts"
      ],
      "@qntx/wallet-native": ["../../packages/wallet-native/src/index.ts"],
      "@qntx/wallet-native/secure-input": ["../../packages/wallet-native/src/secure-input.ts"],
      "@qntx/wallet-native/cloud": ["../../packages/wallet-native/src/cloud.ts"],
      "react-native-nitro-modules": [
        "../../packages/wallet-native/node_modules/react-native-nitro-modules/lib/typescript/index.d.ts"
      ]
    }
  },
  "include": ["."]
}
